# Variables d'environnement du frontend. Aucune n'est secrete : le frontend ne
# detient jamais de secret.
#
# API_URL : URL du backend vue par le serveur Next.js (composants serveur, routes
# /api internes). Lue a l'execution.
API_URL=http://localhost:8080

# NEXT_PUBLIC_API_URL : URL du backend vue par le navigateur, figee au build.
# En developpement : http://localhost:8080. Dans les images deployees : vide, le
# navigateur appelle /api sur le domaine de la page (route vers le backend par
# Traefik) et la meme image sert la preproduction et la production.
NEXT_PUBLIC_API_URL=http://localhost:8080
