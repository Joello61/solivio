# .env.example - frontend (solivio-frontend)
# Reference for all environment variables used by the frontend.
# Copy the relevant section to the appropriate .env.* file.
#
# Next.js environment file loading order (highest to lowest priority):
#   .env.local          (git-ignored, personal overrides, always loaded)
#   .env.development    (committed, loaded in: npm run dev)
#   .env.test           (committed, loaded in: npm test)
#   .env.production     (committed, loaded in: npm run build / npm start)
#   .env                (committed, baseline for all environments)
#
# IMPORTANT: Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# All other variables are server-side only (Next.js server components, API routes).
#
# Place this file at: solivio-frontend/.env.example

# ---- Committed in .env (baseline) ----
NEXT_PUBLIC_APP_NAME=Solivio

# ---- Committed in .env.development ----
API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_LOGIN_URL=http://localhost:8080/oauth2/authorization/keycloak
NEXT_PUBLIC_AUTH_LOGOUT_URL=http://localhost:8080/logout

# ---- Set in production (Coolify environment, never committed) ----
# API_URL=https://api.your-domain.com
# NEXT_PUBLIC_API_URL=https://api.your-domain.com
# NEXT_PUBLIC_APP_URL=https://your-domain.com
# NEXT_PUBLIC_AUTH_LOGIN_URL=https://api.your-domain.com/oauth2/authorization/keycloak
# NEXT_PUBLIC_AUTH_LOGOUT_URL=https://api.your-domain.com/logout

# ---- Add to solivio-frontend/.gitignore ----
# .env.local
# .env.production.local
# .env.development.local
# .env.test.local