# .env.test
# Loaded automatically by Next.js and Vitest when running tests.
# This file IS committed. Do not put secrets here.
#
# Place this file at: solivio-frontend/.env.test

# Point to a test backend instance.
# In CI, the backend is mocked (MSW or similar) or a test server is started.
API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_AUTH_LOGIN_URL=http://localhost:8080/oauth2/authorization/keycloak
NEXT_PUBLIC_AUTH_LOGOUT_URL=http://localhost:8080/logout a