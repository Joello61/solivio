# .env.development
# Loaded automatically by Next.js when running: npm run dev
# This file IS committed. Do not put secrets here.
# For personal overrides: create .env.local (git-ignored, highest priority).
#
# NOTE: The user asked for .env.dev — Next.js does not recognize that filename.
# The correct convention is .env.development (loaded in development mode) and
# .env.production (loaded in production mode). Using any other name requires
# explicit loading and loses Next.js automatic environment loading.
#
# Place this file at: solivio-frontend/.env.development

# Server-side only: URL used by Next.js server components to call the backend.
# Not exposed to the browser (no NEXT_PUBLIC_ prefix).
# When running Next.js and Spring Boot both on the host:
API_URL=http://localhost:8080

# Browser-side: URL used by client components to call the backend.
# Must match the URL accessible from the user's browser.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Application URL (used for redirects and canonical links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Spring Boot OAuth2 login endpoint (BFF pattern).
# The frontend redirects here to start the Keycloak login flow.
NEXT_PUBLIC_AUTH_LOGIN_URL=http://localhost:8080/oauth2/authorization/keycloak
NEXT_PUBLIC_AUTH_LOGOUT_URL=http://localhost:8080/logout