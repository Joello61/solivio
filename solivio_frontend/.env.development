# .env.development
# Charge automatiquement par Next.js en mode dev (npm run dev).
# Committer sans secrets. Pour surcharger localement : .env.local (git-ignore).

# URL backend utilisee par les Server Components (non exposee au navigateur).
API_URL=http://localhost:8080

# URL backend utilisee par les Client Components (navigateur).
NEXT_PUBLIC_API_URL=http://localhost:8080

# URL de l'application (frontend).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL du flow OAuth2 Google (initie depuis le frontend, gere par Spring Boot).
NEXT_PUBLIC_AUTH_LOGIN_URL=http://localhost:8080/oauth2/authorization/google
