# .env.example - backend (solivio-api)
# Place this file at: solivio-api/.env.example
#
# How to use locally:
#   1. Copy to solivio-api/.env (git-ignored, never commit .env)
#   2. Fill the values
#   3. In IntelliJ: Edit Run Configuration > Modify options > Environment variables
#      > Load variables from file > select .env
#   OR use direnv (https://direnv.net): add .env to solivio-api/.envrc
#
# Docker Compose injects these values automatically via the environment: section.
# This file is only needed when running Spring Boot directly on the host (outside Docker).

# Spring profile to activate (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# OpenBao / Vault
SPRING_CLOUD_VAULT_URI=http://localhost:8200
SPRING_CLOUD_VAULT_TOKEN=root

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5436/solivio
SPRING_DATASOURCE_USERNAME=solivio
SPRING_DATASOURCE_PASSWORD=solivio_dev

# Kafka - use the EXTERNAL listener port from docker-compose-dev.yml
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9093

# Mail - Mailpit in dev
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Keycloak
# Format: http(s)://<host>:<port>/realms/<realm-name>
KEYCLOAK_ISSUER_URI=http://localhost:9090/realms/solivio
# Client secret configured in Keycloak admin console for solivio-backend client
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_IN_KEYCLOAK_ADMIN

# Add .env to solivio-api/.gitignore:
#   .env
#   .env.local