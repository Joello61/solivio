# Variables d'environnement de Solivio.
#
# Ce fichier documente la liste complete, sans aucune valeur reelle.
# En production, les valeurs sont injectees par Infisical au lancement
# (infisical run -- docker compose up -d) : aucun fichier .env rempli
# n'existe sur le serveur. Ne jamais committer un .env rempli.

# Base de donnees (service postgres de docker-compose.yml)
DB_NAME=solivio
DB_USER=solivio
DB_PASSWORD=

# Signature des JWT : 32 octets minimum, par exemple `openssl rand -base64 48`.
# L'application refuse de demarrer si elle est absente ou trop courte.
SOLIVIO_AUTH_JWT_SECRET=

# Durees de vie des jetons (optionnel)
SOLIVIO_ACCESS_TOKEN_EXPIRATION=15
SOLIVIO_REFRESH_TOKEN_EXPIRATION=30

# Connexion Google (OAuth 2.0). Obligatoire hors profil dev.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cle Google Maps Platform, restreinte par referent HTTP. Vide = carte desactivee.
GOOGLE_MAPS_API_KEY=

# Envoi des emails : Brevo (SMTP relay, STARTTLS sur 587). Identifiant et cle SMTP
# dans Brevo > SMTP & API > SMTP (une cle SMTP, pas une cle d'API).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Expediteur : adresse d'un domaine authentifie dans Brevo (DKIM, SPF, DMARC)
SOLIVIO_MAIL_FROM=noreply@joeltech.fr

# URL publique de l'application (frontend et /api sur le meme domaine) :
# redirections apres connexion et origine CORS autorisee
FRONTEND_URL=https://solivio.joeltech.fr

# Observabilite (port de gestion 8081, jamais route par Traefik)
# Jeton attendu de Prometheus sur /actuator/prometheus, par exemple `openssl rand -hex 32`.
# Meme valeur que secrets/metrics_scrape_token_solivio (ou _solivio_staging) du depot infrastructure.
METRICS_SCRAPE_TOKEN=
# staging ou production, fixe par ssh-deploy.sh : etiquette des journaux, metriques et traces
DEPLOYMENT_ENVIRONMENT=production
# Optionnel : point de reception OTLP des traces (Tempo) et taux d'echantillonnage
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://tempo:4318/v1/traces
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0

# Images deployees (exportees par docker/deploy/ssh-deploy.sh, jamais dans Infisical)
# BACKEND_IMAGE=ghcr.io/<proprietaire>/<depot>-backend:<sha>
# FRONTEND_IMAGE=ghcr.io/<proprietaire>/<depot>-frontend:<sha>
# BACKUP_IMAGE=ghcr.io/<proprietaire>/<depot>-backup:<sha>

# Sauvegardes (service backup, docker/backup/README.md). Jeton R2 dedie, limite au
# bucket des sauvegardes ; le chiffrement utilise la cle publique versionnee.
R2_ENDPOINT=https://<id-compte>.r2.cloudflarestorage.com
R2_BACKUPS_BUCKET=solivio-backups
R2_BACKUPS_ACCESS_KEY_ID=
R2_BACKUPS_SECRET_ACCESS_KEY=
# Optionnel : URL du moniteur push Uptime Kuma, sans parametres
# (http://<conteneur-uptime-kuma>:3001/api/push/<jeton>)
BACKUP_HEARTBEAT_URL=
